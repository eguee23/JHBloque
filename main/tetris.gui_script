-- Bloques: un Tetris sencillo para Defold (Android / iOS / escritorio)
-- Controles tactiles: tocar = rotar, deslizar a los lados = mover,
-- deslizar hacia abajo = caida rapida.
-- Teclado (para probar en PC): flechas y espacio.

local COLS, ROWS, CELL = 10, 20, 40
local OX, OY = 70, 80          -- esquina inferior izquierda del tablero
local SWIPE_STEP = 40          -- pixeles de arrastre por cada movimiento lateral
local TAP_MAX = 20             -- movimiento maximo para considerarlo un toque
local DROP_SWIPE = 90          -- deslizamiento hacia abajo para caida rapida

-- Cada pieza es una matriz; el numero indica el color
local SHAPES = {
	{ {1,1,1,1} },                  -- I
	{ {2,2}, {2,2} },               -- O
	{ {0,3,0}, {3,3,3} },           -- T
	{ {0,4,4}, {4,4,0} },           -- S
	{ {5,5,0}, {0,5,5} },           -- Z
	{ {6,0,0}, {6,6,6} },           -- J
	{ {0,0,7}, {7,7,7} },           -- L
}

local COLORS = {
	[0] = vmath.vector4(0.13, 0.13, 0.17, 1),
	vmath.vector4(0.20, 0.85, 0.90, 1),
	vmath.vector4(0.95, 0.85, 0.20, 1),
	vmath.vector4(0.70, 0.35, 0.90, 1),
	vmath.vector4(0.30, 0.85, 0.35, 1),
	vmath.vector4(0.92, 0.30, 0.30, 1),
	vmath.vector4(0.30, 0.45, 0.95, 1),
	vmath.vector4(0.97, 0.60, 0.20, 1),
}

local LINE_POINTS = { 0, 100, 300, 500, 800 }

local function rotate(shape)
	local h, w = #shape, #shape[1]
	local r = {}
	for i = 1, w do
		r[i] = {}
		for j = 1, h do
			r[i][j] = shape[h - j + 1][i]
		end
	end
	return r
end

local function valid(self, shape, px, py)
	for r = 1, #shape do
		for c = 1, #shape[r] do
			if shape[r][c] ~= 0 then
				local x, y = px + c - 1, py + r - 1
				if x < 1 or x > COLS or y > ROWS then
					return false
				end
				if y >= 1 and self.board[y][x] ~= 0 then
					return false
				end
			end
		end
	end
	return true
end

local function render(self)
	for y = 1, ROWS do
		for x = 1, COLS do
			gui.set_color(self.cells[y][x], COLORS[self.board[y][x]])
		end
	end
	if self.piece and not self.over then
		local s = self.piece
		for r = 1, #s.shape do
			for c = 1, #s.shape[r] do
				local v = s.shape[r][c]
				if v ~= 0 then
					local x, y = s.x + c - 1, s.y + r - 1
					if y >= 1 and y <= ROWS and x >= 1 and x <= COLS then
						gui.set_color(self.cells[y][x], COLORS[v])
					end
				end
			end
		end
	end
end

local function update_text(self)
	local level = 1 + math.floor(self.lines / 10)
	if self.over then
		gui.set_text(self.score_node, "Fin! " .. self.score .. " pts - toca")
	else
		gui.set_text(self.score_node, "Puntos: " .. self.score .. "  Nivel: " .. level)
	end
end

local function new_piece(self)
	local shape = SHAPES[math.random(#SHAPES)]
	local w = #shape[1]
	self.piece = { shape = shape, x = math.floor((COLS - w) / 2) + 1, y = 1 }
	if not valid(self, self.piece.shape, self.piece.x, self.piece.y) then
		self.over = true
	end
end

local function reset(self)
	self.board = {}
	for y = 1, ROWS do
		self.board[y] = {}
		for x = 1, COLS do
			self.board[y][x] = 0
		end
	end
	self.score, self.lines, self.over, self.timer = 0, 0, false, 0
	new_piece(self)
	update_text(self)
	render(self)
end

local function lock_piece(self)
	local s = self.piece
	for r = 1, #s.shape do
		for c = 1, #s.shape[r] do
			local v = s.shape[r][c]
			if v ~= 0 then
				local x, y = s.x + c - 1, s.y + r - 1
				if y >= 1 then
					self.board[y][x] = v
				end
			end
		end
	end
	-- borrar filas completas
	local cleared = 0
	local y = ROWS
	while y >= 1 do
		local full = true
		for x = 1, COLS do
			if self.board[y][x] == 0 then full = false break end
		end
		if full then
			table.remove(self.board, y)
			local empty = {}
			for x = 1, COLS do empty[x] = 0 end
			table.insert(self.board, 1, empty)
			cleared = cleared + 1
		else
			y = y - 1
		end
	end
	if cleared > 0 then
		local level = 1 + math.floor(self.lines / 10)
		self.score = self.score + LINE_POINTS[cleared + 1] * level
		self.lines = self.lines + cleared
	end
	new_piece(self)
	update_text(self)
end

local function move(self, dx)
	local p = self.piece
	if valid(self, p.shape, p.x + dx, p.y) then
		p.x = p.x + dx
		render(self)
	end
end

local function step_down(self)
	local p = self.piece
	if valid(self, p.shape, p.x, p.y + 1) then
		p.y = p.y + 1
	else
		lock_piece(self)
	end
	render(self)
end

local function hard_drop(self)
	local p = self.piece
	while valid(self, p.shape, p.x, p.y + 1) do
		p.y = p.y + 1
	end
	lock_piece(self)
	render(self)
end

local function turn(self)
	local p = self.piece
	local r = rotate(p.shape)
	-- intenta rotar, y si choca con una pared prueba desplazando un poco
	for _, kick in ipairs({0, -1, 1, -2, 2}) do
		if valid(self, r, p.x + kick, p.y) then
			p.shape, p.x = r, p.x + kick
			render(self)
			return
		end
	end
end

function init(self)
	math.randomseed(os.time())
	msg.post(".", "acquire_input_focus")
	self.score_node = gui.get_node("score")

	-- fondo del tablero
	local fondo = gui.new_box_node(
		vmath.vector3(OX + COLS * CELL / 2, OY + ROWS * CELL / 2, 0),
		vmath.vector3(COLS * CELL + 8, ROWS * CELL + 8, 0))
	gui.set_color(fondo, vmath.vector4(0.35, 0.35, 0.42, 1))

	self.cells = {}
	for y = 1, ROWS do
		self.cells[y] = {}
		for x = 1, COLS do
			local px = OX + (x - 1) * CELL + CELL / 2
			local py = OY + (ROWS - y) * CELL + CELL / 2
			self.cells[y][x] = gui.new_box_node(
				vmath.vector3(px, py, 0), vmath.vector3(CELL - 2, CELL - 2, 0))
		end
	end
	self.touching = false
	reset(self)
end

function update(self, dt)
	if self.over then return end
	local level = 1 + math.floor(self.lines / 10)
	local interval = math.max(0.1, 0.8 - (level - 1) * 0.07)
	self.timer = self.timer + dt
	if self.timer >= interval then
		self.timer = 0
		step_down(self)
		update_text(self)
	end
end

function on_input(self, action_id, action)
	-- teclado
	if action_id == hash("left") and action.pressed and not self.over then
		move(self, -1)
	elseif action_id == hash("right") and action.pressed and not self.over then
		move(self, 1)
	elseif action_id == hash("rotate") and action.pressed and not self.over then
		turn(self)
	elseif action_id == hash("down") and (action.pressed or action.repeated) and not self.over then
		step_down(self)
		update_text(self)
	elseif action_id == hash("drop") and action.pressed and not self.over then
		hard_drop(self)
		update_text(self)
	end

	-- toque / raton
	if action_id == hash("touch") then
		if action.pressed then
			if self.over then
				reset(self)
				return true
			end
			self.touching = true
			self.start_x, self.start_y = action.x, action.y
			self.last_x = action.x
			self.moved = false
		elseif action.released and self.touching then
			self.touching = false
			if not self.over then
				local dy = action.y - self.start_y
				if not self.moved and math.abs(action.x - self.start_x) < TAP_MAX and math.abs(dy) < TAP_MAX then
					turn(self)
				elseif dy < -DROP_SWIPE and math.abs(action.x - self.start_x) < DROP_SWIPE then
					hard_drop(self)
					update_text(self)
				end
			end
		end
	elseif action_id == nil and self.touching and not self.over then
		-- arrastre: mover una columna por cada SWIPE_STEP pixeles
		while action.x - self.last_x >= SWIPE_STEP do
			self.last_x = self.last_x + SWIPE_STEP
			self.moved = true
			move(self, 1)
		end
		while self.last_x - action.x >= SWIPE_STEP do
			self.last_x = self.last_x - SWIPE_STEP
			self.moved = true
			move(self, -1)
		end
	end
end
